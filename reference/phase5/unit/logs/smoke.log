=== spec:Uni-Uni
(; k_ES_to_E_P, k_E_S_to_ES, k_ES_to_E_S, Keq, E_total) = params
(; S, P) = concs
# Haldane constraints:
k_E_P_to_ES = k_ES_to_E_P * k_E_S_to_ES / (k_ES_to_E_S * Keq)
N = k_ES_to_E_P + k_ES_to_E_S
v = E_total * (k_ES_to_E_P * k_E_S_to_ES / N) * (S - P / Keq) / (1 + S * k_E_S_to_ES / N + P * k_ES_to_E_P * k_E_S_to_ES / (k_ES_to_E_S * Keq * N))
--- coefficient form
v = E_total * (n_0) * (S - P / Keq) / (1 + d_S * S + d_P * P)
# The coefficients are functions of the fitted constants, not parameters:
N = k_ES_to_E_P + k_ES_to_E_S
n_0 = k_ES_to_E_P * k_E_S_to_ES / N
d_S = k_E_S_to_ES / N
d_P = k_ES_to_E_P * k_E_S_to_ES / (k_ES_to_E_S * Keq * N)

=== spec:Segel Ping Pong Bi Bi
(; k_E_A_to_EA, k_EA_to_E_A, k_E_Q_to_FB, k_FB_to_E_Q, k_EA_to_F_P, k_F_B_to_FB, k_FB_to_F_B, Keq, E_total) = params
(; A, B, P, Q) = concs
# Haldane constraints:
k_F_P_to_EA = k_E_A_to_EA * k_FB_to_E_Q * k_EA_to_F_P * k_F_B_to_FB / (k_EA_to_E_A * k_E_Q_to_FB * k_FB_to_F_B * Keq)
N = (k_FB_to_E_Q + k_FB_to_F_B) * (k_EA_to_E_A + k_EA_to_F_P) / (k_FB_to_E_Q + k_EA_to_F_P)
v = E_total * (k_E_A_to_EA * k_F_B_to_FB / N) * (A * B - P * Q / Keq) / (A * k_E_A_to_EA * (k_FB_to_E_Q + k_FB_to_F_B) / (k_FB_to_E_Q * N) + B * k_F_B_to_FB * (k_EA_to_E_A + k_EA_to_F_P) / (k_EA_to_F_P * N) + P * k_E_A_to_EA * k_F_B_to_FB * (k_FB_to_E_Q + k_FB_to_F_B) / (k_E_Q_to_FB * k_FB_to_F_B * Keq * N) + Q * k_E_Q_to_FB * k_FB_to_F_B * (k_EA_to_E_A + k_EA_to_F_P) / (k_FB_to_E_Q * k_EA_to_F_P * N) + A * B * k_E_A_to_EA * k_F_B_to_FB * (k_FB_to_E_Q + k_EA_to_F_P) / (k_FB_to_E_Q * k_EA_to_F_P * N) + A * P * k_E_A_to_EA^2 * k_F_B_to_FB * (k_FB_to_E_Q + k_FB_to_F_B) / (k_EA_to_E_A * k_E_Q_to_FB * k_FB_to_F_B * Keq * N) + B * Q * k_E_Q_to_FB * k_F_B_to_FB * (k_EA_to_E_A + k_EA_to_F_P) / (k_FB_to_E_Q * k_EA_to_F_P * N) + P * Q * k_E_A_to_EA * k_F_B_to_FB * (k_EA_to_E_A + k_FB_to_F_B) / (k_EA_to_E_A * k_FB_to_F_B * Keq * N))
--- coefficient form
v = E_total * (n_0) * (A * B - P * Q / Keq) / (d_A * A + d_B * B + d_P * P + d_Q * Q + d_A_B * A * B + d_A_P * A * P + d_B_Q * B * Q + d_P_Q * P * Q)
# The coefficients are functions of the fitted constants, not parameters:
N = (k_FB_to_E_Q + k_FB_to_F_B) * (k_EA_to_E_A + k_EA_to_F_P) / (k_FB_to_E_Q + k_EA_to_F_P)
n_0 = k_E_A_to_EA * k_F_B_to_FB / N
d_A = k_E_A_to_EA * (k_FB_to_E_Q + k_FB_to_F_B) / (k_FB_to_E_Q * N)
d_B = k_F_B_to_FB * (k_EA_to_E_A + k_EA_to_F_P) / (k_EA_to_F_P * N)
d_P = k_E_A_to_EA * k_F_B_to_FB * (k_FB_to_E_Q + k_FB_to_F_B) / (k_E_Q_to_FB * k_FB_to_F_B * Keq * N)
d_Q = k_E_Q_to_FB * k_FB_to_F_B * (k_EA_to_E_A + k_EA_to_F_P) / (k_FB_to_E_Q * k_EA_to_F_P * N)
d_A_B = k_E_A_to_EA * k_F_B_to_FB * (k_FB_to_E_Q + k_EA_to_F_P) / (k_FB_to_E_Q * k_EA_to_F_P * N)
d_A_P = k_E_A_to_EA^2 * k_F_B_to_FB * (k_FB_to_E_Q + k_FB_to_F_B) / (k_EA_to_E_A * k_E_Q_to_FB * k_FB_to_F_B * Keq * N)
d_B_Q = k_E_Q_to_FB * k_F_B_to_FB * (k_EA_to_E_A + k_EA_to_F_P) / (k_FB_to_E_Q * k_EA_to_F_P * N)
d_P_Q = k_E_A_to_EA * k_F_B_to_FB * (k_EA_to_E_A + k_FB_to_F_B) / (k_EA_to_E_A * k_FB_to_F_B * Keq * N)

=== spec:Segel Hexa Uni Ping Pong
(; k_E_A_to_EA, k_EA_to_E_A, k_E_R_to_GC, k_GC_to_E_R, k_F_P_to_EA, k_EA_to_F_P, k_F_B_to_FB, k_FB_to_F_B, k_FB_to_G_Q, k_G_C_to_GC, k_GC_to_G_C, Keq, E_total) = params
(; A, B, C, P, Q, R) = concs
# Haldane constraints:
