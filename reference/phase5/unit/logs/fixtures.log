errors: full 4.8e-154 coef 1.9e-154 full2 4.8e-154 slice 1.9e-154/1.9e-154 ref 1.1e-154; units full true coef true ( ) slice false/false (v term A has units (1//1, 0//1) v term d_A * A has units (1//1, 0//1)); artifacts 0
(; k_E_A_to_F_P, k_F_P_to_E_A, k_F_A_to_E_P, Keq, E_total) = params
(; A, P) = concs
# Haldane constraints:
k_E_P_to_F_A = k_E_A_to_F_P * k_F_A_to_E_P / (k_F_P_to_E_A * Keq^2)
N = k_E_A_to_F_P + k_F_A_to_E_P
v = E_total * (2 * k_E_A_to_F_P * k_F_A_to_E_P / N + 2 * P * k_E_A_to_F_P * k_F_A_to_E_P / (A * Keq * N)) * (A - P / Keq) / (1 + P * (k_E_A_to_F_P * k_F_A_to_E_P + k_F_P_to_E_A^2 * Keq^2) / (A * k_F_P_to_E_A * Keq^2 * N))
--- coefficient form
v = E_total * (n_0 + n_P_A⁻¹ * P / A) * (A - P / Keq) / (1 + d_P_A⁻¹ * P / A)
# The coefficients are functions of the fitted constants, not parameters:
N = k_E_A_to_F_P + k_F_A_to_E_P
n_0 = 2 * k_E_A_to_F_P * k_F_A_to_E_P / N
n_P_A⁻¹ = 2 * k_E_A_to_F_P * k_F_A_to_E_P / (Keq * N)
d_P_A⁻¹ = (k_E_A_to_F_P * k_F_A_to_E_P + k_F_P_to_E_A^2 * Keq^2) / (k_F_P_to_E_A * Keq^2 * N)
