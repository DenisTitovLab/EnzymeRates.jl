(; k_E_A_to_F_P, k_F_P_to_E_A, k_F_A_to_E_P, K_F_A_A_to_FAA, Keq, E_total) = params
(; A, P) = concs
# Haldane constraints:
k_E_P_to_F_A = k_E_A_to_F_P * k_F_A_to_E_P / (k_F_P_to_E_A * Keq^2)
N = (k_E_A_to_F_P + k_F_A_to_E_P)^(3/2)
v = E_total * (2 * A * k_E_A_to_F_P^(3/2) * k_F_A_to_E_P * sqrt(K_F_A_A_to_FAA) / N + 2 * P * k_E_A_to_F_P^(3/2) * k_F_A_to_E_P * sqrt(K_F_A_A_to_FAA) / (Keq * N)) * (A - P / Keq) / (A * sqrt(k_E_A_to_F_P) * sqrt(K_F_A_A_to_FAA) * (k_E_A_to_F_P + k_F_A_to_E_P) / N + P * sqrt(k_E_A_to_F_P) * sqrt(K_F_A_A_to_FAA) * (k_E_A_to_F_P * k_F_A_to_E_P + k_F_P_to_E_A^2 * Keq^2) / (k_F_P_to_E_A * Keq^2 * N) + A^3 * k_E_A_to_F_P^(3/2) * K_F_A_A_to_FAA^(3/2) / N + A^2 * P * k_E_A_to_F_P^(3/2) * k_F_A_to_E_P * K_F_A_A_to_FAA^(3/2) / (k_F_P_to_E_A * Keq^2 * N))
--- coefficient form
v = E_total * (n_A * A + n_P * P) * (A - P / Keq) / (d_A * A + d_P * P + d_A³ * A^3 + d_A²_P * A^2 * P)
# The coefficients are functions of the fitted constants, not parameters:
N = (k_E_A_to_F_P + k_F_A_to_E_P)^(3/2)
n_A = 2 * k_E_A_to_F_P^(3/2) * k_F_A_to_E_P * sqrt(K_F_A_A_to_FAA) / N
n_P = 2 * k_E_A_to_F_P^(3/2) * k_F_A_to_E_P * sqrt(K_F_A_A_to_FAA) / (Keq * N)
d_A = sqrt(k_E_A_to_F_P) * sqrt(K_F_A_A_to_FAA) * (k_E_A_to_F_P + k_F_A_to_E_P) / N
d_P = sqrt(k_E_A_to_F_P) * sqrt(K_F_A_A_to_FAA) * (k_E_A_to_F_P * k_F_A_to_E_P + k_F_P_to_E_A^2 * Keq^2) / (k_F_P_to_E_A * Keq^2 * N)
d_A³ = k_E_A_to_F_P^(3/2) * K_F_A_A_to_FAA^(3/2) / N
d_A²_P = k_E_A_to_F_P^(3/2) * k_F_A_to_E_P * K_F_A_A_to_FAA^(3/2) / (k_F_P_to_E_A * Keq^2 * N)
